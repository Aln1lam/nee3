<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" width="1920" height="1080" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="bannerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#5ba369;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2d5a3d;stop-opacity:1" />
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#ffffff" stroke-width="0.5" opacity="0.1"/>
    </pattern>
  </defs>
  
  <!-- Background -->
  <rect width="1920" height="1080" fill="url(#bannerGrad)"/>
  <rect width="1920" height="1080" fill="url(#grid)"/>
  
  <!-- Large decorative geometric shapes -->
  <circle cx="400" cy="300" r="300" fill="#ffffff" opacity="0.05"/>
  <circle cx="1600" cy="800" r="400" fill="#ffffff" opacity="0.08"/>
  <polygon points="0,1080 500,800 0,600" fill="#ffffff" opacity="0.03"/>
  <polygon points="1920,0 1920,400 1500,200" fill="#ffffff" opacity="0.05"/>
  
  <!-- Text -->
  <text x="960" y="400" font-family="Arial, sans-serif" font-size="120" font-weight="bold" text-anchor="middle" fill="#ffffff" opacity="0.9">
    NEEPU CTF
  </text>
  <text x="960" y="520" font-family="Arial, sans-serif" font-size="48" text-anchor="middle" fill="#ffffff" opacity="0.7">
    Welcome to NEEPU CTF Platform
  </text>
  
  <!-- Bottom accent line -->
  <line x1="600" y1="750" x2="1320" y2="750" stroke="#ffffff" stroke-width="3" opacity="0.5"/>
</svg>
