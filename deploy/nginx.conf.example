# NEEPU CTF 单机 Nginx 示例
# 复制到 /etc/nginx/sites-available/neepu 后按需修改域名与证书路径。
#
#   sudo ln -s /etc/nginx/sites-available/neepu /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

upstream neepu_api {
    server 127.0.0.1:5000;
    keepalive 8;
}

# HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ctf.example.edu.cn;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ctf.example.edu.cn;

    # Let's Encrypt 或校内证书
    ssl_certificate     /etc/letsencrypt/live/ctf.example.edu.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ctf.example.edu.cn/privkey.pem;

    # 前端构建产物
    root /opt/neepu/frontend/dist;
    index index.html;

    client_max_body_size 32m;

    # API 反代到 Gunicorn
    location /api/ {
        proxy_pass http://neepu_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }

    # Vue SPA：其余路径回退到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 可选：禁止缓存 index.html，便于发版后立即生效
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
