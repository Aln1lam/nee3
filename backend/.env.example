# 数据库
NEPU_DATABASE_URL=mysql+pymysql://neepu_user:123456@localhost:3306/neepu
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# 安全
NEPU_JWT_SECRET=please-replace-with-openssl-rand-hex-32-chars
NEPU_DEBUG=1
# 开发默认关 CSRF；生产请设 NEPU_DEBUG=0（将默认开启 CSRF）
# NEPU_JWT_CSRF=1
NEPU_MAX_RUNNING_INSTANCES=2
# ZIP 上传加固（可选）
# NEPU_ZIP_MAX_COMPRESSED=20971520
# NEPU_ZIP_MAX_UNCOMPRESSED=83886080
# NEPU_ZIP_MAX_RATIO=40
# NEPU_ZIP_MAX_FILES=200
# 生产建议：NEPU_DEBUG=0 且开启验证码
# NEPU_CAPTCHA_REQUIRED=1
# NEPU_JWT_CSRF=1

# 前端
FRONTEND_URL=http://localhost:5173

# 动态容器公网地址（比赛部署时改为服务器公网 IP 或域名）
NEPU_CONTAINER_PUBLIC_HOST=127.0.0.1

# Redis（默认启用，无 Redis 时自动降级为内存模式）
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# 中间件
ENABLE_COMPRESSION=true
SECURITY_POLICY=moderate

# 邮件（可选）
# MAIL_SERVER=smtp.qq.com
# MAIL_PORT=465
# MAIL_USE_SSL=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=
# MAIL_SENDER_NAME=NEEPU CTF
