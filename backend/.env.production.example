# NEEPU CTF 单机生产环境示例
# 复制为 backend/.env 后修改密码与域名，勿提交到 git。

# --- 数据库（本机 MySQL）---
NEPU_DATABASE_URL=mysql+pymysql://neepu_user:CHANGE_ME@127.0.0.1:3306/neepu
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- 安全（必须修改）---
NEPU_JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32
NEPU_DEBUG=0

# --- 站点 ---
FRONTEND_URL=https://ctf.example.edu.cn

# --- 动态容器题（公网 IP 或域名，学生从此地址访问题目容器）---
NEPU_CONTAINER_PUBLIC_HOST=ctf.example.edu.cn

# --- Redis（Docker，仅本机）---
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# --- 中间件 ---
ENABLE_COMPRESSION=true
SECURITY_POLICY=moderate

# --- Gunicorn（可选覆盖 deploy/gunicorn.conf.py 默认值）---
# NEPU_GUNICORN_WORKERS=2
# NEPU_GUNICORN_THREADS=4
# NEPU_GUNICORN_BIND=127.0.0.1:5000

# --- 邮件（需要邮箱验证时配置）---
# MAIL_SERVER=smtp.example.edu.cn
# MAIL_PORT=465
# MAIL_USE_SSL=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=ctf@example.edu.cn
# MAIL_SENDER_NAME=NEEPU CTF
